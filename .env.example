# Copy to .env and fill in. Never commit .env.

# --- Supabase (Phase 1) ---
# Project URL and anon key are safe for the browser; the service role key is server-only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string for Drizzle migrations (Supabase > Settings > Database).
DATABASE_URL=

# --- Anthropic (Phase 3) --- server-only
ANTHROPIC_API_KEY=
# ZATCA gateway: developer-portal (testing), simulation, or core (live invoices).
ZATCA_ENVIRONMENT=developer-portal
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ZATCA_KEY_SECRET=
# Optional daily AI caps per company.
# AI_DAILY_DOCUMENT_LIMIT=50
# AI_DAILY_ASSISTANT_LIMIT=100
# DAILY_EMAIL_LIMIT=50

# --- Resend (Phase 4) --- server-only
RESEND_API_KEY=
EMAIL_FROM="AI Invoice <invoices@yourdomain.sa>"

# --- App ---
APP_URL=http://localhost:3000
# Deployment preset for the build: node-server (default) or vercel.
NITRO_PRESET=node-server
